# The local Ollama model used by new agents.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=20
DECISION_INTERVAL_SECONDS=1.2
# Auto speed doubles every 120 running seconds: 2x -> 4x -> 8x.
AUTO_ACCELERATION_SECONDS=120
# Base day length at 1x. The default 2x starts with 30-real-second days.
DAY_LENGTH_SECONDS=60

# Natural event rates are per simulated day (0.01 means about one event per 100 days).
NATURAL_EVENT_PROBABILITY=0.01
DISEASE_EMERGENCE_PROBABILITY=0.002
MAX_SAVED_EVENTS=1000

# Optional path override; defaults to backend/data/world.sqlite3.
# AI_WORLD_DATABASE=backend/data/world.sqlite3

# Comma-separated browser origins for the separately hosted frontend.
# FRONTEND_ORIGINS=http://localhost:5173,https://your-frontend.example
